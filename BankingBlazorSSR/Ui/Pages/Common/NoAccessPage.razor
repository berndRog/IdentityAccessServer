@page "/no-access"
@using System.Security.Claims
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization

@attribute [AllowAnonymous]

<PageTitle>Zugriff verweigert</PageTitle>

<div class="alert alert-warning" role="alert">
  <h4 class="alert-heading">Zugriff verweigert</h4>
  <p>Sie haben keine passende Rolle für den Zugriff auf diese Anwendung.</p>

  <AuthorizeView>
    <Authorized Context="auth">
      <hr>
      <p class="mb-0">
        <strong>Ihr AccountDto:</strong>
        @(auth.User.FindFirst("preferred_username")?.Value ?? auth.User.Identity?.Name ?? "(unknown)")
      </p>

      <details class="mt-3">
        <summary>Claims (Debug-Info)</summary>
        <pre class="mt-2">@GetClaimsDebugInfo(auth.User)</pre>
      </details>

      <div class="mt-3">
        <p class="mb-1"><strong>IsInRole(Customer):</strong> @auth.User.IsInRole("Customer")</p>
        <p class="mb-1"><strong>IsInRole(Employee):</strong> @auth.User.IsInRole("Employee")</p>
      </div>

      <p class="mt-3">
        <a href="/identity/logout" class="btn btn-primary">Abmelden</a>
      </p>

      <AuthorizeView Roles="Customer,Employee">
        <Authorized>
          <div class="alert alert-info mt-3 mb-0" role="alert">
            Hinweis: Du bist in \`Customer\`/\`Employee\` \- wenn du trotzdem hier landest, kommt die Weiterleitung wahrscheinlich aus eigener Logik und nicht aus Policy\-AuthZ\.
          </div>
        </Authorized>
      </AuthorizeView>
    </Authorized>

    <NotAuthorized>
      <p class="mt-3">
        <a href="/identity/login" class="btn btn-primary">Anmelden</a>
      </p>
    </NotAuthorized>
  </AuthorizeView>
</div>

@code {
  private static string GetClaimsDebugInfo(ClaimsPrincipal user)
  {
    if (user?.Identity?.IsAuthenticated != true) return "No authenticated user";

    var claims = user.Claims
      .Select(c => $"{c.Type}: {c.Value}")
      .ToList();

    return string.Join("\n", claims);
  }
}