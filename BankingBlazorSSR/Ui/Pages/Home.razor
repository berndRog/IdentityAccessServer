@page "/"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@inject NavigationManager Nav
@attribute [AllowAnonymous]

<PageTitle>Banking Client</PageTitle>

<div class="container py-4" style="max-width: 860px;">
  <h1 class="h3 mb-3">Banking</h1>

  <AuthorizeView Context="auth">
    <NotAuthorized>
      <p class="text-muted">
        Sie sind angemeldet. Bitte oben im Menü auf
        <a href="@LoginUrl" class="link-primary fw-semibold">Anmelden</a>
        klicken.
      </p>
    </NotAuthorized>

    <Authorized>
      @{
        var user = auth.User;
        var isOwner = user.IsInRole("CustomerDto");
        var isEmployee = user.IsInRole("Employee");
        var displayName =
          user.FindFirst("preferred_username")?.Value
          ?? user.Identity?.Name
          ?? "(unknown)";
      }

      <p class="text-muted">Angemeldet als <b>@displayName</b></p>

      <div class="d-flex gap-2 flex-wrap">
        @if (isOwner)
        {
          <a class="btn btn-primary" href="/customers">CustomerDto Bereich</a>
          <a class="btn btn-outline-secondary" href="/customers/profile">Profil</a>
        }

        @if (isEmployee)
        {
          <a class="btn btn-primary" href="/employee">Employee Bereich</a>
        }
      </div>

      @if (!isOwner && !isEmployee)
      {
        <div class="alert alert-warning mt-3">
          Keine passende Rolle gefunden.
        </div>
      }
    </Authorized>
  </AuthorizeView>
</div>

@code {
  private string CurrentRelativeUrl => Nav.ToBaseRelativePath(Nav.Uri);
  private string LoginUrl =>
    "/identity/login?returnUrl=" + Uri.EscapeDataString("/" + CurrentRelativeUrl);
}
