@page "/employees"
@using Microsoft.AspNetCore.Authorization
@inherits BankingBlazorSsr.Ui.Common.BasePage
@attribute [Authorize(Roles = "Employee")]

<PageTitle>Mitarbeiter</PageTitle>

<div class="container-fluid mt-3">

  @if (Loading) {
    <p>Lade …</p>
  }
  else if (!string.IsNullOrWhiteSpace(ErrorMessage)) {
    <div class="alert alert-danger">@ErrorMessage</div>
  }
  else {
    <div class="row">
      <div class="col-12 mx-1">
        <EmployeesTable EmployeeDtos="@_employeeDtos" OnOpenEmployee="OpenEmployee" />
      </div>
    </div>

    <div class="d-flex justify-content-center mt-3">
      <button type="button" class="btn btn-outline-primary action-btn" @onclick="GoBack">Zurück</button>
    </div>
  }

</div>
