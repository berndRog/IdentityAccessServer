@page "/employees/profile"
@using Microsoft.AspNetCore.Authorization
@inherits BankingBlazorSsr.Ui.Common.BasePage
@attribute [Authorize(Roles = "Employee")]

<PageTitle>Mitarbeiterprofil</PageTitle>

<div class="container py-4" style="max-width: 860px;">
    <div class="mb-3">
        <h1 class="h3 mb-1">Profil Mitarbeiter</h1>
    </div>

    @if (Onboarding) {
        <div class="alert alert-info" role="alert">
            Bitte vervollständige jetzt das Mitarbeiterprofil. Danach ist das Onboarding abgeschlossen.
            Die fachliche Aktivierung erfolgt entweder direkt mit ausreichenden Rechten oder durch einen anderen berechtigten Mitarbeiter.
        </div>
    }

    @if (Loading) {
        <p>Lade …</p>
    }
    else {
        <EditForm EditContext="_editContext" OnValidSubmit="SaveAsync" novalidate>
            <DataAnnotationsValidator/>

            @* Global validation *@
            @if (_showGlobalErrors) {
                <div class="alert alert-danger" role="alert">
                    <div class="fw-semibold mb-1">Eingaben prüfen</div>
                    <ValidationSummary/>
                </div>
            }

            <!-- Basisdaten -->
            <div class="card shadow-sm mb-3">
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <InputFieldString Id="firstname"
                                              Label="Vorname"
                                              @bind-Value="_employeeDto.Firstname"
                                              Placeholder="dein Vorname ..."/>
                        </div>
                        <div class="col-md-6">
                            <InputFieldString Id="lastname"
                                              Label="Nachname"
                                              @bind-Value="_employeeDto.Lastname"
                                              Placeholder="dein Nachname ..."/>
                        </div>

                        <div class="col-12">
                            <InputFieldString Id="email" 
                                              Label="E-Mail" 
                                              Placeholder="E-Mail" 
                                              Type="email"
                                              @bind-Value="_employeeDto.EmailString"/>
                        </div>
                        <div class="col-12">
                            <InputFieldString Id="phone" 
                                              Label="Telefon" 
                                              Placeholder="Telefon" 
                                              Type="tel"
                                              @bind-Value="_employeeDto.PhoneString"/>
                        </div>
                        <div class="col-12">
                            <InputFieldString Id="personnelNumber" 
                                              Label="Personalnummer" 
                                              Placeholder="Personalnummer" 
                                              @bind-Value="_employeeDto.PersonnelNumber"/>
                        </div>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(_saveError)) {
                        <div class="alert alert-danger mt-3" role="alert">@_saveError</div>
                    }
                    @if (!string.IsNullOrWhiteSpace(_saveOk)) {
                        <div class="alert alert-success mt-3" role="alert">@_saveOk</div>
                    }
                    @if (!string.IsNullOrWhiteSpace(_activationInfo)) {
                        <div class="alert alert-info mt-3" role="alert">@_activationInfo</div>
                    }

                    <div class="d-flex justify-content-center mt-3 gap-2 flex-wrap">
                        @if (Onboarding) {
                            @if (_onboardingCompleted) {
                                @if (CanSelfActivate) {
                                    <button type="button"
                                            class="btn btn-primary action-btn"
                                            @onclick="ActivateAsync"
                                            disabled="@_activating">
                                        Mitarbeiter aktivieren
                                    </button>
                                }

                                <button type="button"
                                        class="btn btn-outline-primary action-btn"
                                        @onclick="FinishOnboarding">
                                    @(_employeeDto.IsActive ? "Zum Mitarbeiterbereich" : "Fertig")
                                </button>
                            }
                            else {
                                <button type="button"
                                        class="btn btn-neutral action-btn"
                                        @onclick="Cancel">
                                    Eingaben zurücksetzen
                                </button>

                                <button type="submit"
                                        class="btn btn-primary action-btn"
                                        disabled="@_saving">
                                    Profil speichern
                                </button>
                            }
                        }
                        else {
                            <ButtonsCancelLeaveSubmit
                                OnSubmit="SaveAsync"
                                OnCancel="Cancel"
                                DisabledSubmit="@_saving" />
                        }
                    </div>
                </div>
            </div>
        </EditForm>
    }
</div>
