@page "/accounts/{id:guid}"
@using Microsoft.AspNetCore.Authorization
@inherits BankingBlazorSsr.Ui.Common.BasePage
@attribute [Authorize(Roles = "Customer, Employee")]

<PageTitle>Konto</PageTitle>

<div class="container mt-3">
  @if (Loading)
  {
    <p>Lade …</p>
  }
  else if (!string.IsNullOrEmpty(ErrorMessage))
  {
    <div class="alert alert-danger">@ErrorMessage</div>
  }
  else
  {
    <div class="row">
      <div class="col-12 mb-3 me-md-3">
        <CustomerCard CustomerDto="@_customerDto"/>
      </div>

      <div class="col-12 mb-3">
        <AccountCard AccountDto="@_accountDto"/>
      </div>

      <div class="col-12 mb-3">
        <BeneficiariesTable Beneficiaries="_beneficiaryDtos" />
      </div>
    </div>

    <div class="d-flex justify-content-center mt-3">
      <button type="button" class="btn btn-outline-primary action-btn" @onclick="GoBack">Zurück</button>
    </div>
  }
</div>