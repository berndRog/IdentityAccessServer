@page "/accounts/iban/{IbanString}"
@using Microsoft.AspNetCore.Authorization
@inherits BankingBlazorSsr.Ui.Common.BasePage
@attribute [Authorize(Roles = "Customer, Employee")]

<div class="container mt-3">
  @if (!string.IsNullOrEmpty(ErrorMessage)) {
    <div class="alert alert-danger">@ErrorMessage</div>
  }
  
  <div class="row">
    <div class="col-12 mb-3 me-md-3">
      <CustomerCard CustomerDto="@_customerDto"/>
    </div>

    <div class="col-12 mb-3">
      <AccountCard AccountDto="@_accountDto"/>
    </div>

    <!-- Buttons Row (wrapped in a column for proper alignment) -->
    <div class="col-12">
      <ButtonsTwo Button1Text="Überweisen" Button2Text="Kontoauszüge"
                  OnButton1="HandleTransfers" OnButton2="HandleTransactions"/>
    </div>
  </div>
</div>