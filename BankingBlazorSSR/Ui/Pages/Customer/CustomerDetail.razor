@page "/customers/{Id:guid}"
@using Microsoft.AspNetCore.Authorization
@inherits BankingBlazorSsr.Ui.Common.BasePage
@attribute [Authorize(Roles = "Customer, Employee")]

<PageTitle>Kunde</PageTitle>

<div class="container mt-3">
  @if (Loading)
  {
    <p>Lade …</p>
  }
  else if (!string.IsNullOrEmpty(ErrorMessage))
  {
    <div class="alert alert-danger">@ErrorMessage</div>
  }
  else
  {
    <div class="row">
      <div class="col-12 mb-1 me-md-1">
        <CustomerCard CustomerDto="@_customerDto" />
      </div>

      <div class="col-12 mb-1">
        <AccountsTable AccountDtos="@_accountDtos" OnOpenAccount="OpenAccount" />
      </div>
    </div>

    <div class="d-flex justify-content-center mt-3">
      <button type="button" class="btn btn-outline-primary action-btn" @onclick="GoBack">Zurück</button>
    </div>
  }
</div>