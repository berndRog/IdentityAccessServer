@using Microsoft.AspNetCore.Components.Authorization
@inject NavigationManager Nav

<nav>
  <div class="app-main navbar navbar-expand-sm navbar-light bg-light border-top border-bottom py-2">

    <a class="navbar-brand fw-bold" href="/">SuderBank</a>

    <!-- Hamburger erscheint nur < 576px -->
    <button class="navbar-toggler ms-auto" type="button"
            data-bs-toggle="collapse"
            data-bs-target="#topmenu"
            aria-controls="topmenu"
            aria-expanded="false"
            aria-label="Toggle navigation">
      <span class="navbar-toggler-icon"></span>
    </button>

    <div class="collapse navbar-collapse" id="topmenu">

      <AuthorizeView Context="auth">
        <Authorized>

          <ul class="navbar-nav">
            @if (auth.User.IsInRole("Customer"))
            {
              <li class="nav-item"><NavLink class="nav-link" href="/entry">Dashboard</NavLink></li>
              <li class="nav-item"><NavLink class="nav-link" href='@WithReturnUrl("/accounts")'>Konten</NavLink></li>
              <li class="nav-item"><NavLink class="nav-link" href='@WithReturnUrl("/transfers")'>Überweisungen</NavLink></li>
            }

            @if (auth.User.IsInRole("Employee"))
            {
              <li class="nav-item"><NavLink class="nav-link" href="/entry">Dashboard</NavLink></li>
              <li class="nav-item"><NavLink class="nav-link" href='@WithReturnUrl("/customers")'>Kunden</NavLink></li>
              <li class="nav-item"><NavLink class="nav-link" href='@WithReturnUrl("/accounts")'>Konten</NavLink></li>

              <li class="nav-item"><NavLink class="nav-link" href='@WithReturnUrl("/employees")'>Mitarbeiter</NavLink></li>
            }
          </ul>

          <a class="btn btn-outline-danger btn-sm ms-sm-auto mt-2 mt-sm-0" href="@LogoutUrl">
            Abmelden
          </a>

        </Authorized>

        <NotAuthorized>
          @* <ul class="navbar-nav"> *@
          @*   <li class="nav-item"><NavLink class="nav-link" href="/">Start</NavLink></li> *@
          @* </ul> *@

          <a class="btn btn-primary btn-sm ms-sm-auto mt-2 mt-sm-0" href="@LoginUrl">
            Anmelden
          </a>
        </NotAuthorized>
      </AuthorizeView>

    </div>
  </div>
</nav>


@code {
  // Current relative URL incl. query so we can return back.
  private string CurrentRelativeUrl => Nav.ToBaseRelativePath(Nav.Uri);

  private string WithReturnUrl(string targetPath)
    => targetPath + "?returnUrl=" + Uri.EscapeDataString("/" + CurrentRelativeUrl);

  // Route every fresh login through /entry so provisioning/onboarding can decide the next step.
  private string LoginUrl => "/identity/login?returnUrl=" + Uri.EscapeDataString("/entry");


  // serverseitiger Logout (Cookie + OIDC)
  private string LogoutUrl => "/identity/logout";
}
