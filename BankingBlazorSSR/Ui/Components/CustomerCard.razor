@using BankingBlazorSsr.Api.Dtos
<div class="card shadow-sm w-100">
  <div class="card-body">
    <h5 class="card-title">Kontoinhaber</h5>
    <div class="mb-2">
      <label class="fw-normal">Name:</label>
      <span class="ms-2">@CustomerDto.Firstname @CustomerDto.Lastname</span>
    </div>
    <div class="mb-2">
      <label class="fw-normal">E-Mail:</label>
      <span class="ms-2">@CustomerDto.EmailString</span>
    </div>
  </div>
</div>

@code {
  [Parameter] public required CustomerDto CustomerDto { get; set; }
}

