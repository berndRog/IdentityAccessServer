@using Microsoft.AspNetCore.Identity
@using IdentityAccessServer.Data
@using IdentityAccessServer.Infrastructure.Identity
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

<ul class="navbar-nav">
  @if (SignInManager.IsSignedIn(User))
  {
    var currentUser = await UserManager.GetUserAsync(User);
    var canRegisterEmployees = currentUser?.AccountType == "employee"
      && (currentUser.AdminRights & AdminRights.ManageEmployees) == AdminRights.ManageEmployees;
    var canRegisterCustomers = currentUser?.AccountType == "employee"
      && (currentUser.AdminRights & AdminRights.ManageCustomers) == AdminRights.ManageCustomers;

    <li class="nav-item">
      <span class="nav-link text-dark">Hello @User.Identity?.Name!</span>
    </li>
    @if (canRegisterCustomers)
    {
      <li class="nav-item">
        <a class="nav-link text-dark" asp-area="Identity" asp-page="/Account/RegisterCustomer">Register customer</a>
      </li>
    }
    @if (canRegisterEmployees)
    {
      <li class="nav-item">
        <a class="nav-link text-dark" asp-area="Identity" asp-page="/Account/RegisterEmployee">Register employee</a>
      </li>
    }
    <li class="nav-item">
      <form class="form-inline" asp-area="Identity" asp-page="/Account/Logout" method="post">
        <button type="submit" class="nav-link btn btn-link text-dark">Logout</button>
      </form>
    </li>
  }
  else
  {
    <li class="nav-item">
      <a class="nav-link text-dark" asp-area="Identity" asp-page="/Account/Login">Login</a>
    </li>
  }
</ul>
