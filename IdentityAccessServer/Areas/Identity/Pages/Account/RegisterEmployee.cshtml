@page
@model RegisterEmployeeModel
@{
    ViewData["Title"] = "Register employee";
}

<h1>@ViewData["Title"]</h1>

@if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
{
    <div class="alert alert-success" role="alert">@Model.StatusMessage</div>
    <div class="mb-3">
        <a class="btn btn-outline-primary" href="@Model.BankingEmployeesUrl">Zur Mitarbeiterliste</a>
    </div>
}

<div class="row">
    <div class="col-md-5">
        <form id="registerEmployeeForm" asp-route-returnUrl="@Model.ReturnUrl" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>

            <div class="form-floating mb-3">
                <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="name@example.com" />
                <label asp-for="Input.Email">Email</label>
                <span asp-validation-for="Input.Email" class="text-danger"></span>
            </div>

            <div class="form-floating mb-3">
                <input asp-for="Input.Password" class="form-control" autocomplete="new-password" aria-required="true" placeholder="password" />
                <label asp-for="Input.Password">Temporary password</label>
                <span asp-validation-for="Input.Password" class="text-danger"></span>
            </div>

            <div class="form-floating mb-3">
                <input asp-for="Input.ConfirmPassword" class="form-control" autocomplete="new-password" aria-required="true" placeholder="password" />
                <label asp-for="Input.ConfirmPassword">Confirm password</label>
                <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
            </div>

            <fieldset class="mb-3">
                <legend class="h6">Admin rights</legend>

                <div class="form-check">
                    <input asp-for="Input.ViewReports" class="form-check-input" />
                    <label asp-for="Input.ViewReports" class="form-check-label">View reports</label>
                </div>
                <div class="form-check">
                    <input asp-for="Input.ViewCustomers" class="form-check-input" />
                    <label asp-for="Input.ViewCustomers" class="form-check-label">View customers</label>
                </div>
                <div class="form-check">
                    <input asp-for="Input.ManageCustomers" class="form-check-input" />
                    <label asp-for="Input.ManageCustomers" class="form-check-label">Manage customers</label>
                </div>
                <div class="form-check">
                    <input asp-for="Input.ViewAccounts" class="form-check-input" />
                    <label asp-for="Input.ViewAccounts" class="form-check-label">View accounts</label>
                </div>
                <div class="form-check">
                    <input asp-for="Input.ManageAccounts" class="form-check-input" />
                    <label asp-for="Input.ManageAccounts" class="form-check-label">Manage accounts</label>
                </div>
                <div class="form-check">
                    <input asp-for="Input.ViewEmployees" class="form-check-input" />
                    <label asp-for="Input.ViewEmployees" class="form-check-label">View employees</label>
                </div>
                <div class="form-check">
                    <input asp-for="Input.ManageEmployees" class="form-check-input" />
                    <label asp-for="Input.ManageEmployees" class="form-check-label">Manage employees</label>
                </div>
            </fieldset>

            <button id="registerEmployeeSubmit" type="submit" class="w-100 btn btn-lg btn-primary">Register employee</button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
